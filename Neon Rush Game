  for (const e of enemies) drawEnemy(e);

  if (showPlayer && !(G.invuln > 0 && Math.floor(G.invuln * 12) % 2 === 0)) {
    drawShip(ctx, P.x, P.y, P.ang, P.r * S * 1.25, shipColor(), curShip().shape);
  }
  if (showPlayer && G.shield > 0) {
    const flick = G.shield < 2 ? (Math.floor(G.shield * 8) % 2 ? 0.3 : 1) : 0.85 + 0.15 * Math.sin(G.t * 8);
    ctx.globalAlpha = flick; ctx.strokeStyle = COL.mint; ctx.lineWidth = 2.5;
    ctx.beginPath(); ctx.arc(P.x, P.y, P.r * S * 2.2, 0, TAU); ctx.stroke(); ctx.globalAlpha = 1;
  }

