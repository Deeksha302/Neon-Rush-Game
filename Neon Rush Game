<script>
(() => {
'use strict';

/* ---------- helpers ---------- */
const $ = (id) => document.getElementById(id);
const TAU = Math.PI * 2;
const rnd = (a, b) => a + Math.random() * (b - a);
const clamp = (v, a, b) => (v < a ? a : v > b ? b : v);
const angDiff = (a, b) => { let d = a - b; while (d > Math.PI) d -= TAU; while (d < -Math.PI) d += TAU; return d; };
const fmtTime = (s) => { s = Math.floor(s); return Math.floor(s / 60) + ':' + String(s % 60).padStart(2, '0'); };
const fmtNum = (n) => Number(n).toLocaleString('en-US');

const RM = !!(window.matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches);
const COARSE = !!(window.matchMedia && matchMedia('(pointer: coarse)').matches);

const COL = {
  cyan: '#3af0ff', pink: '#ff3d81', amber: '#ffa22e', violet: '#c084ff',
  gold: '#ffe45c', mint: '#5dffb8', blue: '#6ea8ff', red: '#ff5a36', white: '#ffffff'
};

/* ---------- DOM ---------- */
const cv = $('c');
const ctx = cv.getContext('2d');
const hudEl = $('hud'), menuEl = $('menu'), overEl = $('over'), pauseEl = $('pause');
const elScore = $('score'), elMult = $('mult'), elComboBar = $('comboBar'), elTime = $('time'), elHudBest = $('hudBest');
const chipShield = $('chipShield'), chipSlow = $('chipSlow'), barShield = $('barShield'), barSlow = $('barSlow');
const btnSound = $('btnSound');

/* ---------- state ---------- */
let W = 800, H = 600, DPR = 1, S = 1;
let mode = 'menu'; // menu | play | paused | over
let last = performance.now();
let bgGrad = null;

const G = {
  t: 0, score: 0, combo: 0, comboT: 0, orbs: 0, shield: 0, slow: 0, invuln: 0,
  shake: 0, flash: 0, spawnT: 1, orbT: 0, powT: 8, dead: false, deadT: 0, best: 0, newBest: false
};
const P = { x: 0, y: 0, tx: 0, ty: 0, r: 10, ang: -Math.PI / 2, trail: [] };
const enemies = [], orbsA = [], pows = [], parts = [], rings = [], floaters = [];
const stars = [];
const keys = { left: 0, right: 0, up: 0, down: 0 };
let touch = null;

/* ---------- save data (browser storage may be unavailable) ---------- */
const SAVE_KEY = 'neonrush-save-v2';
const defaultSave = () => ({ best: 0, coins: 0, xp: 0, ship: 'cyan', trail: 'classic', owned: ['cyan', 'classic'], day: '', streak: 0, missions: [], sweep: false, runs: 0, name: '' });
let memSave = null;
function loadSave() {
  const sv = defaultSave();
  try {
    const raw = localStorage.getItem(SAVE_KEY);
    if (raw) Object.assign(sv, JSON.parse(raw));
    else { const old = parseInt(localStorage.getItem('neonrush-best') || '0', 10); if (old > 0) sv.best = old; }
  } catch (e) { if (memSave) Object.assign(sv, memSave); }
  if (!Array.isArray(sv.owned)) sv.owned = [];
  ['cyan', 'classic'].forEach((id) => { if (sv.owned.indexOf(id) < 0) sv.owned.push(id); });
  if (!Array.isArray(sv.missions)) sv.missions = [];
  return sv;
}
let SAVE = loadSave();
function persist() {
  memSave = JSON.parse(JSON.stringify(SAVE));
  try { localStorage.setItem(SAVE_KEY, JSON.stringify(SAVE)); } catch (e) { /* memory only */ }
}
const R = { orbs: 0, time: 0, bombs: 0, shields: 0, pows: 0, mult: 1, score: 0 }; // stats for the current run
let RES = null; // results of the last finished run

/* ---------- audio ---------- */
let AC = null, muted = false;
function initAudio() {
  if (!AC) { try { AC = new (window.AudioContext || window.webkitAudioContext)(); } catch (e) { AC = null; } }
  if (AC && AC.state === 'suspended') AC.resume();
}
function tone(f, d, type, v, slide, delay) {
  if (!AC || muted) return;
  const t = AC.currentTime + (delay || 0);
  const o = AC.createOscillator(), g = AC.createGain();
  o.type = type || 'sine';
  o.frequency.setValueAtTime(f, t);
  if (slide) o.frequency.exponentialRampToValueAtTime(Math.max(30, f + slide), t + d);
  g.gain.setValueAtTime(v || 0.07, t);
  g.gain.exponentialRampToValueAtTime(0.0001, t + d);
  o.connect(g); g.connect(AC.destination);
  o.start(t); o.stop(t + d + 0.03);
}
function noise(d, v) {
  if (!AC || muted) return;
  const n = Math.floor(AC.sampleRate * d);
  const buf = AC.createBuffer(1, n, AC.sampleRate);
  const data = buf.getChannelData(0);
  for (let i = 0; i < n; i++) data[i] = (Math.random() * 2 - 1) * (1 - i / n);
  const src = AC.createBufferSource(); src.buffer = buf;
  const g = AC.createGain(); g.gain.value = v;
  src.connect(g); g.connect(AC.destination); src.start();
}
const sfx = {
  start: () => { tone(330, 0.1, 'triangle', 0.07); tone(495, 0.16, 'triangle', 0.07, 0, 0.09); },
  orb: (c) => tone(500 + c * 45, 0.12, 'triangle', 0.07, 260),
  pick: () => { tone(440, 0.1, 'square', 0.045); tone(660, 0.1, 'square', 0.045, 0, 0.08); tone(880, 0.18, 'square', 0.045, 0, 0.16); },
  bomb: () => { noise(0.55, 0.22); tone(150, 0.5, 'sawtooth', 0.12, -110); },
  shield: () => { tone(320, 0.25, 'square', 0.08, -220); noise(0.15, 0.1); },
  die: () => { tone(340, 0.65, 'sawtooth', 0.12, -280); noise(0.45, 0.2); },
  milestone: () => { tone(523, 0.1, 'triangle', 0.08); tone(659, 0.1, 'triangle', 0.08, 0, 0.09); tone(784, 0.1, 'triangle', 0.08, 0, 0.18); tone(1047, 0.25, 'triangle', 0.08, 0, 0.27); },
  win: () => { [523, 659, 784, 1047, 1319].forEach((f, i) => tone(f, 0.18, 'square', 0.05, 0, i * 0.08)); },
  buy: () => { tone(880, 0.08, 'square', 0.05); tone(1320, 0.16, 'square', 0.05, 0, 0.07); },
  pop: () => { noise(0.1, 0.05); tone(220, 0.14, 'sine', 0.05, 200); },
  tick: () => tone(700, 0.03, 'square', 0.025)
};

/* ---------- glow sprites ---------- */
const glowCache = {};
function glowSprite(color) {
  if (glowCache[color]) return glowCache[color];
  const c = document.createElement('canvas'); c.width = c.height = 128;
  const g = c.getContext('2d');
  const gr = g.createRadialGradient(64, 64, 0, 64, 64, 64);
  gr.addColorStop(0, color); gr.addColorStop(0.25, color + 'aa'); gr.addColorStop(1, color + '00');
  g.fillStyle = gr; g.fillRect(0, 0, 128, 128);
  return (glowCache[color] = c);
}
function drawGlow(x, y, r, color, a) {
  ctx.globalAlpha = a; ctx.drawImage(glowSprite(color), x - r, y - r, r * 2, r * 2); ctx.globalAlpha = 1;
}

/* ---------- sizing ---------- */
function resize() {
  const r = cv.getBoundingClientRect();
  W = Math.max(280, r.width); H = Math.max(280, r.height);
  DPR = Math.min(window.devicePixelRatio || 1, 2);
  cv.width = Math.round(W * DPR); cv.height = Math.round(H * DPR);
  ctx.setTransform(DPR, 0, 0, DPR, 0, 0);
  S = clamp(Math.min(W, H) / 720, 0.72, 1.25);
  bgGrad = ctx.createRadialGradient(W / 2, H * 0.45, 0, W / 2, H * 0.45, Math.max(W, H) * 0.75);
  bgGrad.addColorStop(0, '#1b1478'); bgGrad.addColorStop(0.55, '#100b3d'); bgGrad.addColorStop(1, '#0a0820');
  stars.length = 0;
  const n = Math.round((W * H) / 9000);
  for (let i = 0; i < n; i++) stars.push({ x: rnd(0, W), y: rnd(0, H), z: rnd(0.2, 1), tw: rnd(0, TAU) });
  P.x = clamp(P.x, 14, W - 14); P.y = clamp(P.y, 14, H - 14);
  P.tx = clamp(P.tx, 14, W - 14); P.ty = clamp(P.ty, 14, H - 14);
  fxResize();
}

/* ---------- effects ---------- */
function burst(x, y, color, n, spd) {
  if (RM) n = Math.ceil(n * 0.4);
  for (let i = 0; i < n; i++) {
    if (parts.length > 500) break;
    const a = rnd(0, TAU), s = rnd(0.2, 1) * spd;
    parts.push({ x, y, vx: Math.cos(a) * s, vy: Math.sin(a) * s, life: 0, max: rnd(0.4, 0.9), color, size: rnd(1.6, 3.6) });
  }
}
function ring(x, y, color, max, dur) { rings.push({ x, y, color, max, t: 0, dur: dur || 0.45 }); }
function floater(x, y, text, color) { floaters.push({ x, y, text, color, t: 0, dur: 0.9 }); }

/* ---------- game logic ---------- */
const mult = () => Math.min(8, 1 + Math.floor(G.combo / 4));
const colorOf = (e) => (e.kind === 'dart' ? COL.pink : e.kind === 'hunter' ? COL.amber : COL.violet);
const powColor = (k) => (k === 'shield' ? COL.mint : k === 'slow' ? COL.blue : COL.red);
const powName = (k) => (k === 'shield' ? 'Shield' : k === 'slow' ? 'Slow-mo' : 'Bomb');

function reset() {
  G.t = 0; G.score = 0; G.combo = 0; G.comboT = 0; G.orbs = 0; G.shield = 0; G.slow = 0; G.invuln = 1.4;
  G.shake = 0; G.flash = 0; G.spawnT = 1.4; G.orbT = 0.3; G.powT = 8; G.dead = false; G.deadT = 0; G.newBest = false; G.msIdx = 0; G.msCoins = 0; G.spinUsed = false; G.spinText = '';
  R.orbs = R.time = R.bombs = R.shields = R.pows = R.score = 0; R.mult = 1; RES = null;
  enemies.length = 0; orbsA.length = 0; pows.length = 0; parts.length = 0; rings.length = 0; floaters.length = 0;
  P.x = P.tx = W / 2; P.y = P.ty = H * 0.62; P.ang = -Math.PI / 2; P.trail.length = 0;
  hs.score = hs.time = hs.mult = -1; hs.sh = hs.sl = null;
}

function pickKind() {
  const w = [['dart', 3]];
  if (G.t > 10) w.push(['hunter', 1.4]);
  if (G.t > 22) w.push(['wave', 2]);
  let total = 0; for (const x of w) total += x[1];
  let r = Math.random() * total;
  for (const x of w) { if ((r -= x[1]) <= 0) return x[0]; }
  return 'dart';
}

function spawnEnemy(kind) {
  kind = kind || pickKind();
  const side = (Math.random() * 4) | 0, m = 40;
  let x, y;
  if (side === 0) { x = rnd(0, W); y = -m; }
  else if (side === 1) { x = W + m; y = rnd(0, H); }
  else if (side === 2) { x = rnd(0, W); y = H + m; }
  else { x = -m; y = rnd(0, H); }
  const speedMul = (1 + Math.min(1.1, G.t * 0.009)) * S;
  const jit = mode === 'menu' ? 320 : 80;
  const aim = Math.atan2(P.y - y + rnd(-jit, jit), P.x - x + rnd(-jit, jit));
  const e = { kind, x, y, a: aim, age: 0, ang: aim, spin: rnd(0, TAU) };
  if (kind === 'dart') { e.sp = rnd(150, 210) * speedMul; e.r = 8 * S; }
  else if (kind === 'hunter') { e.sp = rnd(85, 115) * Math.min(speedMul, 1.5 * S); e.r = 10 * S; e.life = 9; e.turn = rnd(1.4, 1.9); }
  else { e.sp = rnd(120, 160) * speedMul; e.r = 8 * S; e.bx = x; e.by = y; e.amp = rnd(60, 110) * S * (Math.random() < 0.5 ? -1 : 1); e.fr = rnd(3, 5); }
  enemies.push(e);
}

function freeSpot(margin, avoid) {
  for (let i = 0; i < 20; i++) {
    const x = rnd(margin, W - margin), y = rnd(margin, H - margin);
    if (Math.hypot(x - P.x, y - P.y) > avoid) return { x, y };
  }
  return { x: rnd(margin, W - margin), y: rnd(margin, H - margin) };
}

function updateEnemies(d) {
  for (let i = enemies.length - 1; i >= 0; i--) {
    const e = enemies[i];
    e.age += d; e.spin += d * 4;
    const ox = e.x, oy = e.y;
    if (e.kind === 'dart') {
      e.x += Math.cos(e.a) * e.sp * d; e.y += Math.sin(e.a) * e.sp * d;
    } else if (e.kind === 'hunter') {
      const ta = Math.atan2(P.y - e.y, P.x - e.x), mx = e.turn * d;
      e.a += clamp(angDiff(ta, e.a), -mx, mx);
      e.x += Math.cos(e.a) * e.sp * d; e.y += Math.sin(e.a) * e.sp * d;
      e.life -= d;
      if (e.life <= 0) { burst(e.x, e.y, COL.amber, 10, 90); enemies.splice(i, 1); continue; }
    } else {
      e.bx += Math.cos(e.a) * e.sp * d; e.by += Math.sin(e.a) * e.sp * d;
      const off = Math.sin(e.age * e.fr) * e.amp;
      e.x = e.bx - Math.sin(e.a) * off; e.y = e.by + Math.cos(e.a) * off;
    }
    if (Math.abs(e.x - ox) + Math.abs(e.y - oy) > 0.01) e.ang = Math.atan2(e.y - oy, e.x - ox);
    if (e.x < -170 || e.x > W + 170 || e.y < -170 || e.y > H + 170) enemies.splice(i, 1);
  }
}

function updateFx(dt) {
  for (let i = parts.length - 1; i >= 0; i--) {
    const p = parts[i];
    p.life += dt; p.x += p.vx * dt; p.y += p.vy * dt;
    const f = 1 - 2.2 * dt; p.vx *= f; p.vy *= f;
    if (p.life > p.max) parts.splice(i, 1);
  }
  for (let i = rings.length - 1; i >= 0; i--) { rings[i].t += dt; if (rings[i].t > rings[i].dur) rings.splice(i, 1); }
  for (let i = floaters.length - 1; i >= 0; i--) { const f = floaters[i]; f.t += dt; f.y -= 34 * dt; if (f.t > f.dur) floaters.splice(i, 1); }
  G.shake = Math.max(0, G.shake - dt * 2.6);
  G.flash = Math.max(0, G.flash - dt * 2.2);
}

function collectOrb(o) {
  G.combo++; G.comboT = 3.2; G.orbs++;
  const m = mult(), pts = 10 * m;
  if (m > R.mult) R.mult = m;
  G.score += pts;
  floater(o.x, o.y - 14, '+' + pts, COL.gold);
  burst(o.x, o.y, COL.gold, 10, 130);
  ring(o.x, o.y, COL.gold, 36 * S, 0.35);
  sfx.orb(Math.min(G.combo, 12));
  if (G.combo % 4 === 0 && m > 1) floater(P.x, P.y - 34, 'Combo x' + m, COL.cyan);
}

function collectPow(p) {
  const c = powColor(p.kind);
  R.pows++; if (p.kind === 'shield') R.shields++; else if (p.kind === 'bomb') R.bombs++;
  sfx.pick();
  burst(p.x, p.y, c, 18, 200);
  ring(p.x, p.y, c, 60 * S, 0.5);
  floater(p.x, p.y - 20, powName(p.kind), c);
  if (p.kind === 'shield') G.shield = 8;
  else if (p.kind === 'slow') G.slow = 5;
  else {
    const n = enemies.length, pts = n * 5 * mult();
    for (const e of enemies) burst(e.x, e.y, colorOf(e), 12, 210);
    enemies.length = 0;
    G.score += pts;
    ring(P.x, P.y, COL.red, Math.max(W, H) * 0.7, 0.75);
    G.flash = 1; G.shake = 0.8;
    sfx.bomb();
    if (n) floater(P.x, P.y - 40, '+' + pts, COL.white);
  }
}

function die() {
  G.dead = true; G.deadT = 0;
  burst(P.x, P.y, COL.cyan, 60, 330);
  burst(P.x, P.y, COL.white, 20, 200);
  ring(P.x, P.y, COL.cyan, 120 * S, 0.6);
  G.shake = 1;
  sfx.die();
  finishRun();
}

function hitEnemy(i) {
  const e = enemies[i];
  if (G.invuln > 0) return;
  if (G.shield > 0) {
    G.shield = 0; G.invuln = 1.1;
    burst(e.x, e.y, colorOf(e), 20, 230);
    ring(P.x, P.y, COL.mint, 80 * S, 0.45);
    enemies.splice(i, 1);
    G.shake = 0.5;
    sfx.shield();
    return;
  }
  die();
}

function update(dt) {
  const slowStars = G.slow > 0 ? 0.4 : 1;
  for (const s of stars) {
    s.y += s.z * 14 * dt * slowStars; s.tw += dt * 2 * s.z;
    if (s.y > H) { s.y = 0; s.x = rnd(0, W); }
  }

  if (mode === 'menu') {
    G.spawnT -= dt;
    if (G.spawnT <= 0) { spawnEnemy(Math.random() < 0.6 ? 'dart' : 'wave'); G.spawnT = rnd(0.7, 1.3); }
    updateEnemies(dt); updateFx(dt);
    return;
  }
  if (mode === 'paused') return;
  if (G.dead) {
    updateEnemies(dt * 0.35); updateFx(dt);
    G.deadT += dt;
    if (mode === 'play' && G.deadT > 0.9) showOver();
    return;
  }

  const ts = G.slow > 0 ? 0.45 : 1, d = dt * ts;
  G.t += dt; G.score += dt * 5;
  checkMilestone();
  G.slow = Math.max(0, G.slow - dt);
  G.shield = Math.max(0, G.shield - dt);
  G.invuln = Math.max(0, G.invuln - dt);
  if (G.combo > 0) { G.comboT -= dt; if (G.comboT <= 0) G.combo = 0; }

  // player movement
  const kx = keys.right - keys.left, ky = keys.down - keys.up;
  if (kx || ky) { const l = Math.hypot(kx, ky); P.tx += (kx / l) * 520 * S * dt; P.ty += (ky / l) * 520 * S * dt; }
  P.tx = clamp(P.tx, 14, W - 14); P.ty = clamp(P.ty, 14, H - 14);
  const ox = P.x, oy = P.y, k = 1 - Math.exp(-18 * dt);
  P.x += (P.tx - P.x) * k; P.y += (P.ty - P.y) * k;
  const vx = (P.x - ox) / dt, vy = (P.y - oy) / dt, sp = Math.hypot(vx, vy);
  if (sp > 40) P.ang += angDiff(Math.atan2(vy, vx), P.ang) * Math.min(1, dt * 14);
  P.trail.push({ x: P.x, y: P.y }); if (P.trail.length > 16) P.trail.shift();
  const tr = curTrail(), star = tr.id === 'stardust';
  if (sp > 60 && Math.random() < (star ? 0.95 : 0.6) && parts.length < 500) {
    const pc = tr.rainbow ? hue2hex(rnd(0, 360)) : tr.id === 'classic' ? shipColor() : tr.color;
    parts.push({
      x: P.x - Math.cos(P.ang) * 9 * S, y: P.y - Math.sin(P.ang) * 9 * S,
      vx: rnd(-20, 20) * (star ? 2 : 1), vy: rnd(-20, 20) * (star ? 2 : 1) - (tr.id === 'ember' ? 25 : 0),
      life: 0, max: star ? rnd(0.5, 0.9) : rnd(0.2, 0.4), color: pc, size: star ? rnd(2, 3.8) : rnd(1.5, 2.5)
    });
  }

  // spawning
  G.spawnT -= d;
  if (G.spawnT <= 0 && enemies.length < 45) {
    spawnEnemy();
    if (G.t > 35 && Math.random() < 0.3) spawnEnemy();
    G.spawnT = Math.max(0.28, 1.05 - G.t * 0.0115) * rnd(0.8, 1.2);
  }
  G.orbT -= dt;
  if (G.orbT <= 0) {
    if (orbsA.length < 3) { const s = freeSpot(44, 90 * S); orbsA.push({ x: s.x, y: s.y, r: 7 * S, age: 0, life: 9 }); }
    G.orbT = rnd(0.8, 1.6);
  }
  G.powT -= dt;
  if (G.powT <= 0) {
    if (pows.length === 0) {
      const s = freeSpot(60, 130 * S), kinds = ['shield', 'slow', 'bomb'];
      pows.push({ kind: kinds[(Math.random() * 3) | 0], x: s.x, y: s.y, r: 13 * S, age: 0, life: 10 });
    }
    G.powT = rnd(11, 17);
  }

  updateEnemies(d);
  updateFx(dt);

  // orbs
  const pr = P.r * S;
  for (let i = orbsA.length - 1; i >= 0; i--) {
    const o = orbsA[i];
    o.age += dt;
    const dx = P.x - o.x, dy = P.y - o.y, dist = Math.hypot(dx, dy);
    if (dist < 75 * S && dist > 0.1) { const pull = (1 - dist / (75 * S)) * 320 * S * dt; o.x += (dx / dist) * pull; o.y += (dy / dist) * pull; }
    if (dist < pr + o.r + 6) { collectOrb(o); orbsA.splice(i, 1); continue; }
    if (o.age > o.life) orbsA.splice(i, 1);
  }
  // powerups
  for (let i = pows.length - 1; i >= 0; i--) {
    const p = pows[i];
    p.age += dt;
    if (Math.hypot(P.x - p.x, P.y - p.y) < pr + p.r + 4) { collectPow(p); pows.splice(i, 1); continue; }
    if (p.age > p.life) pows.splice(i, 1);
  }
  // collisions
  const hr = pr * 0.75;
  for (let i = enemies.length - 1; i >= 0; i--) {
    const e = enemies[i], dx = e.x - P.x, dy = e.y - P.y, rr = e.r + hr;
    if (dx * dx + dy * dy < rr * rr) { hitEnemy(i); if (G.dead) break; }
  }
}

/* ---------- drawing ---------- */
const blink = (age, life) => (age > life - 2.5 && Math.floor(age * 8) % 2 === 0 ? 0.35 : 1);

function drawEnemy(e) {
  const c = colorOf(e);
  ctx.save(); ctx.translate(e.x, e.y); ctx.lineJoin = 'round'; ctx.lineCap = 'round';
  if (e.kind === 'dart') {
    ctx.rotate(e.ang); const r = e.r;
    ctx.beginPath(); ctx.moveTo(r * 1.6, 0); ctx.lineTo(-r, -r * 0.95); ctx.lineTo(-r * 0.4, 0); ctx.lineTo(-r, r * 0.95); ctx.closePath();
    ctx.fillStyle = c; ctx.fill(); ctx.strokeStyle = 'rgba(255,255,255,0.85)'; ctx.lineWidth = 1.5; ctx.stroke();
  } else if (e.kind === 'hunter') {
    if (e.life < 1.5 && Math.floor(e.life * 10) % 2 === 0) ctx.globalAlpha = 0.4;
    ctx.rotate(e.spin * 0.5); const r = e.r * 1.1;
    ctx.strokeStyle = c; ctx.lineWidth = 3; ctx.strokeRect(-r, -r, r * 2, r * 2);
    ctx.fillStyle = COL.white; ctx.beginPath(); ctx.arc(0, 0, r * 0.32, 0, TAU); ctx.fill();
  } else {
