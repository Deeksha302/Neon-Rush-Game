    ctx.beginPath(); ctx.moveTo(0, -r * 0.55); ctx.lineTo(r * 0.5, -r * 0.3); ctx.lineTo(r * 0.4, r * 0.2);
    ctx.quadraticCurveTo(0, r * 0.65, -r * 0.4, r * 0.2); ctx.lineTo(-r * 0.5, -r * 0.3); ctx.closePath(); ctx.fill();
  } else if (p.kind === 'slow') {
    ctx.beginPath(); ctx.moveTo(-r * 0.4, -r * 0.5); ctx.lineTo(r * 0.4, -r * 0.5); ctx.lineTo(0, 0); ctx.closePath();
    ctx.moveTo(-r * 0.4, r * 0.5); ctx.lineTo(r * 0.4, r * 0.5); ctx.lineTo(0, 0); ctx.closePath(); ctx.fill();
  } else {
    ctx.beginPath(); ctx.arc(0, 0, r * 0.32, 0, TAU); ctx.fill();
