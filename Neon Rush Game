      ctx.globalAlpha = a * 0.5; ctx.lineWidth = a * 9 * S;
      ctx.beginPath(); ctx.moveTo(P.trail[i - 1].x, P.trail[i - 1].y); ctx.lineTo(P.trail[i].x, P.trail[i].y); ctx.stroke();
    }
    ctx.globalAlpha = 1;
    drawGlow(P.x, P.y, P.r * S * 4.5, sc, 0.7);
    if (G.shield > 0) drawGlow(P.x, P.y, P.r * S * 4.2, COL.mint, 0.45);
  }
  for (const o of orbsA) drawGlow(o.x, o.y, o.r * 4.2, COL.gold, (0.75 * (0.75 + 0.25 * Math.sin(o.age * 6))) * blink(o.age, o.life));
  for (const p of pows) drawGlow(p.x, p.y, p.r * 3.2, powColor(p.kind), 0.7 * blink(p.age, p.life));
  for (const e of enemies) drawGlow(e.x, e.y, e.r * 3.4, colorOf(e), 0.6);
  for (const p of parts) {
    ctx.globalAlpha = 1 - p.life / p.max; ctx.fillStyle = p.color;
