function draw() {
  ctx.setTransform(DPR, 0, 0, DPR, 0, 0);
  ctx.globalCompositeOperation = 'source-over'; ctx.globalAlpha = 1;
  ctx.fillStyle = bgGrad; ctx.fillRect(0, 0, W, H);
  ctx.fillStyle = '#b9c2ff';
  for (const s of stars) {
    ctx.globalAlpha = (0.25 + 0.6 * s.z) * (0.75 + 0.25 * Math.sin(s.tw));
    const sz = s.z * 1.8; ctx.fillRect(s.x, s.y, sz, sz);
  }
  ctx.globalAlpha = 1;

  let sx = 0, sy = 0;
  if (G.shake > 0 && !RM) { sx = rnd(-1, 1) * G.shake * 10; sy = rnd(-1, 1) * G.shake * 10; }
  ctx.save(); ctx.translate(sx, sy);

  const showPlayer = mode !== 'menu' && !G.dead;

  // glow pass
  ctx.globalCompositeOperation = 'lighter';
  if (showPlayer) {
    const sc = shipColor(); ctx.lineCap = 'round';
    for (let i = 1; i < P.trail.length; i++) {
