    const def = mDef(m.id); if (!def) continue;
    const li = document.createElement('li'); li.className = 'm' + (m.done ? ' done' : '');
    const txt = document.createElement('div'); txt.className = 'txt'; txt.textContent = (m.done ? '✓ ' : '') + def.text;
    const rw = document.createElement('div'); rw.className = 'rw'; rw.textContent = '+' + def.reward;
    const prog = document.createElement('div'); prog.className = 'prog';
    const bar = document.createElement('span'); bar.className = 'bar'; bar.style.setProperty('--c', m.done ? 'var(--mint)' : 'var(--cyan)');
    const b = document.createElement('b'); b.style.transform = 'scaleX(' + clamp(m.p / def.target, 0, 1) + ')'; bar.appendChild(b);
    const num = document.createElement('span'); num.textContent = Math.floor(m.p) + ' / ' + def.target;
    prog.append(bar, num); li.append(txt, rw, prog); ul.appendChild(li);
  }
  $('mSweep').textContent = SAVE.sweep ? 'All missions done today. The +100 coin bonus is claimed!' : 'Finish all missions in a day for a +100 coin bonus.';
}

/* ---------- lucky spin ---------- */
const PRIZES = [
  { kind: 'coins', v: 20, w: 38, label: '20', sub: 'coins', c: '#ffe45c' },
  { kind: 'coins', v: 50, w: 26, label: '50', sub: 'coins', c: '#ffe45c' },
  { kind: 'coins', v: 100, w: 14, label: '100', sub: 'coins', c: '#ffe45c' },
  { kind: 'coins', v: 250, w: 5, label: '250', sub: 'coins', c: '#ffe45c' },
  { kind: 'xp', v: 100, w: 12, label: '+100', sub: 'XP', c: '#3af0ff' },
  { kind: 'skin', w: 5, label: 'Rare', sub: 'skin', c: '#ff9be3' }
];
const PITCH = 96, WIN_IDX = 34;
function pickPrize() {
  let total = 0; for (const p of PRIZES) total += p.w;
  let r = Math.random() * total;
  for (const p of PRIZES) { if ((r -= p.w) <= 0) return p; }
  return PRIZES[0];
}
function renderTrack(items) {
  const tk = $('track'); tk.innerHTML = '';
  for (const p of items) {
    const d = document.createElement('div'); d.className = 'cell'; d.style.setProperty('--c', p.c);
    const b = document.createElement('b'); b.textContent = p.label; if (p.label.length > 5) b.style.fontSize = '15px';
    const sm = document.createElement('small'); sm.textContent = p.sub;
    d.append(b, sm); tk.appendChild(d);
  }
}
function openSpin(from) {
  openSub(spinEl, from);
  const tk = $('track'); tk.style.transition = 'none'; tk.style.transform = 'translateX(0)';
  const items = []; for (let i = 0; i < 40; i++) items.push(pickPrize());
  renderTrack(items);
  $('btnDoSpin').disabled = !!G.spinUsed;
  $('btnDoSpin').textContent = G.spinUsed ? 'Already spun' : 'Spin';
  $('spinMsg').textContent = G.spinUsed ? (G.spinText || 'You already used this run\'s spin. Play again for another one!') : '';
  $('spinBack').disabled = false;
  $('btnDoSpin').focus({ preventScroll: true });
}
function doSpin() {
  if (spinBusy || G.spinUsed) return;
  spinBusy = true; G.spinUsed = true; initAudio();
  $('btnDoSpin').disabled = true; $('spinBack').disabled = true; $('spinMsg').textContent = '';
  const win = pickPrize();
  let shown = win, award = { kind: win.kind, v: win.v };
  if (win.kind === 'skin') {
    const pool = [];
    SHIPS.forEach((it) => { if (SAVE.owned.indexOf(it.id) < 0) pool.push({ t: 'ship', it }); });
    TRAILS.forEach((it) => { if (SAVE.owned.indexOf(it.id) < 0) pool.push({ t: 'trail', it }); });
    if (pool.length) {
      const pk = pool[(Math.random() * pool.length) | 0];
      award = { kind: 'skin', it: pk.it }; shown = { kind: 'skin', label: pk.it.name, sub: pk.t, c: win.c };
    } else { award = { kind: 'coins', v: 300 }; shown = { kind: 'coins', label: '300', sub: 'coins', c: '#ffe45c' }; }
  }
  const items = []; for (let i = 0; i < 44; i++) items.push(pickPrize());
  items[WIN_IDX] = shown; renderTrack(items);
  const viewW = $('reelView').clientWidth || 300;
  const off = WIN_IDX * PITCH + 44 - viewW / 2 + rnd(-28, 28);
  const tk = $('track');
  tk.style.transition = 'none'; tk.style.transform = 'translateX(0)'; void tk.offsetWidth;
  const dur = RM ? 0.6 : 3.6;
  tk.style.transition = 'transform ' + dur + 's cubic-bezier(0.1, 0.72, 0.12, 1)';
  tk.style.transform = 'translateX(' + (-off) + 'px)';
  if (!RM) for (let k = 1; k <= 20; k++) setTimeout(sfx.tick, dur * 1000 * Math.pow(k / 20, 1.6));
  setTimeout(() => finishSpin(award), dur * 1000 + 150);
}
function finishSpin(award) {
  let msg;
  if (award.kind === 'coins') { SAVE.coins += award.v; msg = 'You won ' + award.v + ' coins!'; }
  else if (award.kind === 'xp') { SAVE.xp += award.v; msg = 'You won ' + award.v + ' bonus XP!'; }
  else { SAVE.owned.push(award.it.id); msg = 'Unlocked: ' + award.it.name + '! Equip it in the shop.'; }
  persist(); refreshProfile();
  G.spinText = msg; $('spinMsg').textContent = msg;
  spinBusy = false; $('spinBack').disabled = false; $('btnDoSpin').textContent = 'Claimed';
  spawnConfetti(award.kind === 'skin' ? 120 : 50); sfx.win();
}

/* ---------- share ---------- */
const SHARE_URL = ''; // Put your hosted game link here after publishing, e.g. 'https://yourname.github.io/neon-rush/'
async function shareScore() {
  const sc = RES ? RES.sc : Math.floor(G.score);
  const text = 'Maine Neon Rush mein ' + fmtNum(sc) + ' score kiya! Mujhe hara ke dikhao 🚀';
  const url = SHARE_URL || (/^https?:/.test(location.href) ? location.href.split('#')[0] : '');
  try {
    if (navigator.share) { await navigator.share(url ? { text, url } : { text }); return; }
  } catch (e) { if (e && e.name === 'AbortError') return; }
  const full = url ? text + ' ' + url : text;
  const w = window.open('https://wa.me/?text=' + encodeURIComponent(full), '_blank');
  if (w) { try { w.opener = null; } catch (e) { /* ignore */ } return; }
  try { await navigator.clipboard.writeText(full); toast('Copied! Paste it in WhatsApp or anywhere.'); }
  catch (e) { toast('Sharing is not available here.'); }
}
function showMenu() {
  overEl.hidden = true; hudEl.hidden = true;
  rockets.length = 0; sparks.length = 0; confetti.length = 0; fxTime = 0;
  reset(); mode = 'menu'; menuEl.hidden = false;
  refreshProfile();
  $('btnPlay').focus({ preventScroll: true });
}

$('btnShop').addEventListener('click', () => { setTab('ships'); openSub(shopEl, 'menu'); $('shopBack').focus({ preventScroll: true }); });
$('btnShopOver').addEventListener('click', () => { setTab('ships'); openSub(shopEl, 'over'); $('shopBack').focus({ preventScroll: true }); });
$('btnMissions').addEventListener('click', () => { renderMissions(); openSub(missionsEl, 'menu'); $('mBack').focus({ preventScroll: true }); });
$('btnSpin').addEventListener('click', () => openSpin('over'));
$('btnDoSpin').addEventListener('click', doSpin);
$('btnShare').addEventListener('click', shareScore);
$('btnMenu').addEventListener('click', showMenu);
$('tabShips').addEventListener('click', () => setTab('ships'));
$('tabTrails').addEventListener('click', () => setTab('trails'));
$('btnLeaderboard').addEventListener('click', () => { $('lbName').value = SAVE.name || ''; $('lbScoreVal').textContent = fmtNum(SAVE.best); renderLeaderboard(); openSub(leaderboardEl, 'menu'); $('lbName').focus({ preventScroll: true }); });
$('btnLbOver').addEventListener('click', () => { $('lbName').value = SAVE.name || ''; $('lbScoreVal').textContent = fmtNum(SAVE.best); renderLeaderboard(); openSub(leaderboardEl, 'over'); $('lbName').focus({ preventScroll: true }); });
$('btnLbSave').addEventListener('click', submitScore);
$('btnRate').addEventListener('click', () => { renderReviews(); openSub(rateEl, 'menu'); });
$('btnRateSubmit').addEventListener('click', submitReview);
document.querySelectorAll('#starPicker .star').forEach((b) => b.addEventListener('click', () => setStars(Number(b.dataset.v))));
['shopBack', 'mBack', 'spinBack', 'lbBack', 'rateBack'].forEach((id) => $(id).addEventListener('click', closeSub));

/* ---------- boot ---------- */
function frame(now) {
  let dt = (now - last) / 1000; last = now;
  if (dt > 0.05) dt = 0.05;
  if (dt > 0) { update(dt); fxUpdate(dt); }
  if (mode === 'play' && !G.dead) updateHud();
  draw();
  fxDraw();
  requestAnimationFrame(frame);
}

resize();
G.best = SAVE.best;
touchDay();
reset();
$('how').textContent = COARSE ? 'Drag anywhere on the screen to steer your ship.' : 'Move your mouse, or use WASD or the arrow keys. Press P to pause.';
if (G.best > 0) { const mb = $('menuBest'); mb.hidden = false; mb.textContent = 'Your best: ' + fmtNum(G.best); }
elHudBest.textContent = fmtNum(G.best);
refreshProfile();
if (streakNote) { const sm = $('streakMsg'); sm.hidden = false; sm.textContent = streakNote; streakNote = ''; }
$('btnPlay').focus({ preventScroll: true });
requestAnimationFrame(frame);
})();
</script>
