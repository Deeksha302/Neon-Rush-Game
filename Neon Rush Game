    ctx.fillStyle = f.color; ctx.fillText(f.text, f.x, f.y);
  }
  ctx.globalAlpha = 1;
  ctx.restore();

  // screen overlays
  if (G.slow > 0) { ctx.globalAlpha = 0.1; ctx.fillStyle = COL.blue; ctx.fillRect(0, 0, W, H); }
  if (G.flash > 0 && !RM) { ctx.globalAlpha = G.flash * 0.35; ctx.fillStyle = '#ffffff'; ctx.fillRect(0, 0, W, H); }
  ctx.globalAlpha = 1;
}

