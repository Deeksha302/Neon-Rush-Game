    ctx.fillStyle = COL.white; ctx.beginPath(); ctx.arc(0, 0, r * 0.3, 0, TAU); ctx.fill();
  }
  ctx.restore();
}

function drawPow(p) {
  const c = powColor(p.kind), r = p.r;
  ctx.save(); ctx.translate(p.x, p.y);
  ctx.globalAlpha = blink(p.age, p.life);
  ctx.fillStyle = 'rgba(10,8,32,0.88)'; ctx.beginPath(); ctx.arc(0, 0, r, 0, TAU); ctx.fill();
  ctx.strokeStyle = c; ctx.lineWidth = 2.5; ctx.stroke();
