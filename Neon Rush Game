/* ---------- fireworks + confetti (own canvas above the panels) ---------- */
const fx = $('fx'), fctx = fx.getContext('2d');
const rockets = [], sparks = [], confetti = [];
let fxTime = 0, fxNext = 0, fxDirty = false;
const FW_COLORS = [COL.cyan, COL.pink, COL.gold, COL.mint, COL.violet, COL.amber, COL.white];
function fxResize() { fx.width = Math.round(W * DPR); fx.height = Math.round(H * DPR); fctx.setTransform(DPR, 0, 0, DPR, 0, 0); fxDirty = false; }
function launchRocket() {
  rockets.push({ x: rnd(W * 0.15, W * 0.85), y: H + 10, vy: -rnd(520, 700) * Math.max(0.7, H / 720), ty: rnd(H * 0.15, H * 0.45), color: FW_COLORS[(Math.random() * FW_COLORS.length) | 0] });
}
function explode(x, y, color) {
  const n = RM ? 18 : 46;
  for (let i = 0; i < n; i++) {
    if (sparks.length > 400) break;
    const a = rnd(0, TAU), sp = rnd(60, 300);
    sparks.push({ x, y, vx: Math.cos(a) * sp, vy: Math.sin(a) * sp, life: 0, max: rnd(0.8, 1.5), color: Math.random() < 0.25 ? COL.white : color, size: rnd(2, 3.6) });
  }
  sfx.pop();
}
function spawnConfetti(n) {
  if (RM) n = Math.ceil(n * 0.35);
  for (let i = 0; i < n; i++) {
    if (confetti.length > 240) break;
    confetti.push({ x: rnd(0, W), y: rnd(-H * 0.3, -10), vx: rnd(-40, 40), vy: rnd(120, 260), rot: rnd(0, TAU), vr: rnd(-6, 6), w: rnd(6, 10), h: rnd(10, 16), color: FW_COLORS[(Math.random() * FW_COLORS.length) | 0], t: 0, sway: rnd(0, TAU) });
  }
}
function celebrate() { fxTime = RM ? 1.2 : 4.2; fxNext = 0; spawnConfetti(90); }
function fxUpdate(dt) {
  if (fxTime > 0) { fxTime -= dt; fxNext -= dt; if (fxNext <= 0) { launchRocket(); fxNext = rnd(0.3, 0.6); } }
  for (let i = rockets.length - 1; i >= 0; i--) {
    const r = rockets[i]; r.y += r.vy * dt;
    if (r.y <= r.ty) { explode(r.x, r.y, r.color); rockets.splice(i, 1); }
  }
  for (let i = sparks.length - 1; i >= 0; i--) {
    const p = sparks[i]; p.life += dt; p.vy += 240 * dt; p.vx *= 1 - 1.2 * dt; p.x += p.vx * dt; p.y += p.vy * dt;
    if (p.life > p.max) sparks.splice(i, 1);
  }
  for (let i = confetti.length - 1; i >= 0; i--) {
    const c = confetti[i]; c.t += dt; c.y += c.vy * dt; c.x += c.vx * dt + Math.sin(c.t * 3 + c.sway) * 30 * dt; c.rot += c.vr * dt;
    if (c.y > H + 30) confetti.splice(i, 1);
  }
}
function fxDraw() {
  const busy = rockets.length || sparks.length || confetti.length;
  if (!busy) { if (fxDirty) { fctx.setTransform(DPR, 0, 0, DPR, 0, 0); fctx.clearRect(0, 0, W, H); fxDirty = false; } return; }
  fxDirty = true;
  fctx.setTransform(DPR, 0, 0, DPR, 0, 0);
  fctx.clearRect(0, 0, W, H);
  fctx.globalCompositeOperation = 'lighter';
  for (const r of rockets) { fctx.globalAlpha = 0.9; fctx.drawImage(glowSprite(r.color), r.x - 26, r.y - 26, 52, 52); fctx.globalAlpha = 1; fctx.fillStyle = '#ffffff'; fctx.fillRect(r.x - 1.5, r.y - 1.5, 3, 3); }
  for (const p of sparks) { fctx.globalAlpha = 1 - p.life / p.max; fctx.fillStyle = p.color; fctx.fillRect(p.x - p.size / 2, p.y - p.size / 2, p.size, p.size); }
  fctx.globalCompositeOperation = 'source-over';
  for (const c of confetti) {
    fctx.save(); fctx.translate(c.x, c.y); fctx.rotate(c.rot); fctx.scale(1, Math.abs(Math.cos(c.t * 4 + c.sway)) * 0.8 + 0.2);
    fctx.globalAlpha = 0.95; fctx.fillStyle = c.color; fctx.fillRect(-c.w / 2, -c.h / 2, c.w, c.h); fctx.restore();
  }
  fctx.globalAlpha = 1;
}

