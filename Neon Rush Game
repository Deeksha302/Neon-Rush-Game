  { id: 'time90', text: 'Survive 90 seconds in one run', stat: 'time', mode: 'max', target: 90, reward: 90 },
  { id: 'score1200', text: 'Score 1,200 in one run', stat: 'score', mode: 'max', target: 1200, reward: 70 },
  { id: 'score2500', text: 'Score 2,500 in one run', stat: 'score', mode: 'max', target: 2500, reward: 110 },
  { id: 'bomb2', text: 'Use 2 bombs', stat: 'bombs', mode: 'sum', target: 2, reward: 70 },
  { id: 'shield3', text: 'Pick up 3 shields', stat: 'shields', mode: 'sum', target: 3, reward: 60 },
  { id: 'pow6', text: 'Pick up 6 power-ups', stat: 'pows', mode: 'sum', target: 6, reward: 80 },
