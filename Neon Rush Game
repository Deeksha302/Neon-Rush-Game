}
function makeMissions(day) {
  const rand = seededRand(day), pool = MISSION_POOL.slice();
  for (let i = pool.length - 1; i > 0; i--) { const j = Math.floor(rand() * (i + 1)); const t = pool[i]; pool[i] = pool[j]; pool[j] = t; }
  const out = [], used = {};
  for (const m of pool) {
    const key = m.stat + m.mode;
    if (used[key]) continue;
    used[key] = 1; out.push({ id: m.id, p: 0, done: false });
    if (out.length === 3) break;
  }
  return out;
}
let streakNote = '';
function touchDay() {
  const today = todayStr();
  if (SAVE.day === today) return;
  const first = !SAVE.day;
  const y = new Date(); y.setDate(y.getDate() - 1);
  SAVE.streak = SAVE.day === todayStr(y) ? SAVE.streak + 1 : 1;
  SAVE.day = today;
  SAVE.missions = makeMissions(today);
  SAVE.sweep = false;
  const bonus = Math.min(SAVE.streak, 7) * 10;
  SAVE.coins += bonus;
  streakNote = (first ? 'Welcome!' : SAVE.streak > 1 ? 'Day ' + SAVE.streak + ' streak!' : 'Welcome back!') + ' Daily bonus: +' + bonus + ' coins';
  persist();
}
function applyMissions() {
  const done = [];
  for (const m of SAVE.missions) {
    const def = mDef(m.id);
    if (!def || m.done) continue;
    const v = R[def.stat] || 0;
    m.p = def.mode === 'sum' ? m.p + v : Math.max(m.p, v);
    if (m.p >= def.target) { m.p = def.target; m.done = true; done.push({ text: def.text, reward: def.reward }); }
  }
  return done;
}
function finishRun() {
  const sc = Math.floor(G.score);
  R.score = sc; R.time = G.t; R.orbs = G.orbs;
  const isNew = sc > SAVE.best;
  if (isNew) { SAVE.best = sc; G.best = sc; }
  G.newBest = isNew && sc >= 150;
  const coins = Math.floor(sc / 15) + G.orbs + G.msCoins + (G.newBest ? 50 : 0);
  const xpGain = Math.floor(sc / 10) + G.orbs * 2 + Math.floor(G.t);
  const before = levelInfo(SAVE.xp);
  SAVE.xp += xpGain;
  const after = levelInfo(SAVE.xp);
  let levelBonus = 0;
  for (let l = before.lvl + 1; l <= after.lvl; l++) levelBonus += 20 * l;
  const doneM = applyMissions();
  let mCoins = 0;
  for (const m of doneM) mCoins += m.reward;
  let sweep = false;
  if (!SAVE.sweep && SAVE.missions.length && SAVE.missions.every((m) => m.done)) { SAVE.sweep = true; sweep = true; mCoins += 100; }
  const total = coins + levelBonus + mCoins;
  SAVE.coins += total; SAVE.runs++;
  persist();
  RES = { sc, coins, total, xpGain, before, after, levelBonus, doneM, sweep, mCoins };
}

